# Maintainer: seorooficial

pkgname=whatsapp-duo
pkgver=1.0.1
pkgrel=1
pkgdesc='Two isolated WhatsApp Web sessions in one lightweight Linux desktop app'
arch=('any')
url='https://github.com/seorooficial/whatsapp-duo'
license=('MIT')
depends=('electron')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('cde14e07ea33ec93b62771894e0a5a1888f38308d51bf0d5fa6062e67632558b')

package() {
  cd "$pkgname-$pkgver"

  make PREFIX=/usr DESTDIR="$pkgdir" install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
